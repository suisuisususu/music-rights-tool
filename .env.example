# ── 框架必需（生产环境启动时校验，自行部署可填任意非空占位值）──
APP_ID=local
APP_SECRET=local-secret
# 本工具不使用数据库，但框架要求该变量存在，填占位值即可
DATABASE_URL=mysql://unused:unused@localhost:3306/unused

# ── Spotify Web API（可选，强烈建议配置）────────────────────────
# 申请地址：https://developer.spotify.com/dashboard （免费）
# 配置后可获得：ISRC、专辑封面、流行度、专辑 label（Master Owner 线索）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── The MLC Public Search API（可选，付费）──────────────────────
# 官方 API，可查 publishers（含份额/IPI）、词曲作者、ISWC
# 注意：属于 The MLC 付费数据计划（约 $100 设置费 + $25/月订阅）
# 注册：https://www.themlc.com/dataprograms ｜ 文档：https://public-api.themlc.com/api/doc
# 免费替代：网页版 Public Work Search（https://portal.themlc.com/search）手动查询
MLC_USERNAME=
MLC_PASSWORD=

# ── 公开报价案例检索（可选，二选一）─────────────────────────────
# Tavily：https://tavily.com （免费额度 1000 次/月）
TAVILY_API_KEY=
# 或 SerpAPI：https://serpapi.com
SERPAPI_KEY=
